# Upstream REST API. Used server-side by the next.config.ts rewrite that proxies
# same-origin /api/v1/* to this host (the API sends no CORS headers, so the
# browser can't call it directly). Not exposed to the client.
API_BASE_URL=https://api.patchapp.ir

# Neshan static-map key (platform.neshan.org → free signup gives one instantly).
# Used server-side by the /map/static rewrite; never exposed to the client.
# Without it the court map image is hidden and only the مسیریابی link renders.
NESHAN_API_KEY=
